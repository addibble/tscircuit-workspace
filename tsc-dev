#!/usr/bin/env bash
#
# tsc-dev — a tiny workspace manager for multi-repo tscircuit development.
#
# tscircuit is NOT a monorepo: each package lives in its own GitHub repo under
# https://github.com/tscircuit and is published to npm independently. Cross-repo
# development is done with `yalc` (a local package registry). This script just
# automates the clone + build + yalc-link dance described in the handbook:
#   https://github.com/tscircuit/handbook/blob/main/guides/using-yalc.md
#
# All repos are cloned as flat siblings inside this directory (the workspace
# root), e.g. ~/src/tscircuit/core, ~/src/tscircuit/props, ...
#
# workspace.json is the shared config: the curated clone groups, the build-time
# bundling graph that `rebuild --from` walks, and the fork/patch-set efforts that
# `sync-forks` updates. Change configuration there, not in this script.
#
# Usage:
#   ./tsc-dev clone [repo ...]        Clone repos from the tscircuit org (default set if none given)
#   ./tsc-dev clone-deps <repo> [-r]  Clone the tscircuit-org repos <repo> depends on (its dependency
#                                     closure). Add -r/--recursive to follow deps-of-deps. Great for
#                                     exploring "everything core actually uses".
#   ./tsc-dev clone-group <group>     Bulk-clone a curated category (run with no group to list them)
#   ./tsc-dev search <pattern> [..]   ripgrep across every cloned repo (passes extra args to rg)
#   ./tsc-dev install [repo ...]      `bun install` in the given repos (default: all cloned)
#   ./tsc-dev publish <repo>          Build <repo> (if it has a build script) and `yalc publish`
#   ./tsc-dev watch <repo>            Same as publish, but keeps republishing on change (yalc --watch)
#   ./tsc-dev link <consumer> <dep>   In <consumer>, `yalc add` the package provided by <dep> repo
#   ./tsc-dev push <repo>             Rebuild <repo> and `yalc push` to every consumer using it
#   ./tsc-dev unlink <consumer>       Remove all yalc links from <consumer> and restore npm versions
#   ./tsc-dev doctor [target...]      Audit yalc links in repos/projects: detect a local build that
#                                     claims a releasable version, an npm copy that has overwritten a
#                                     link, and stale (unpushed) links. Targets are repo names or
#                                     paths; defaults to every linked repo + project yalc knows about.
#   ./tsc-dev prune-store [--keep N]  Delete old `-local.*` builds from the yalc store (default keep 2
#                                     newest per package). Released versions are never touched.
#   ./tsc-dev pr <repo> <branch>      Create an ISOLATED worktree off upstream main for a small
#                                     upstream fix, without disturbing your feature checkout: its own
#                                     working tree, its own node_modules, and no yalc links (its
#                                     package.json comes from upstream). Options:
#                                       --base <ref>     base other than origin/main
#                                       --pick <commit>  cherry-pick a commit out of your feature branch
#                                       --take <path>    copy a path from your working tree as-is
#                                       --no-install     skip `bun install`
#   ./tsc-dev pr-check <repo> <br>    Run the gates CI runs on a PR for that repo, in the worktree.
#                                     Derived from the repo's own pull_request workflows, so
#                                     repo-specific gates (lint:zod, format:check, smoke-test:dist)
#                                     can't drift out of a hand-maintained list.
#   ./tsc-dev pr-push <repo> <br>     Push the worktree's branch to your fork (or to origin if you
#                                     have write access) and open the PR against tscircuit/<repo>.
#   ./tsc-dev local <sub>             Manage YOUR config layer — a worktree in .local/ on an orphan
#                                     branch (user/<login>) that is pushed only to your fork:
#                                       init [--remote <url>]  create it (migrating user-specific keys
#                                                              out of the shared workspace.json)
#                                       save [-m msg]          commit + push to your fork
#                                       sync                   fast-forward from your fork
#                                       status                 branch, remote, config, lock
#                                       remote <git-url>       set the workspace fork remote
#   ./tsc-dev config [key]            Effective (merged) config, and which layer each key came from
#   ./tsc-dev freeze [-o <file>]      Snapshot this build environment — every cloned repo's
#                                     remote/branch/SHA plus the yalc links — into the user layer
#   ./tsc-dev env <sub>               Peer environments, read from their workspace fork:
#                                       add <owner> [git-url]  register their fork as a remote
#                                       list                   registered peers
#                                       show <owner>           their locked environment
#                                       diff <owner>           how yours differs from theirs
#                                       adopt <owner> --into <dir> | --here    reproduce it
#
# CONFIG LAYERS: workspace.json is SHARED (clone groups, the bundling graph, the
# default clone set — the same in everyone's copy, committed to main).
# .local/workspace.local.json is YOURS (which patch-set effort you are running,
# personal overrides, the environment lock); it is deep-merged over the shared
# file and wins. The local layer is versioned on an ORPHAN branch — no shared
# history with main, so it cannot be merged there by accident and a PR branched
# from main can never drag it along — and pushed only to your fork. That is also
# what makes environments shareable: `env adopt <owner>` reads a colleague's lock
# straight off their fork and reproduces their checkout, fork remotes included.
#   ./tsc-dev pr-link <repo> <br> <d> Link workspace repo <d> into the worktree via a PRIVATE yalc
#                                     store, so it cannot disturb your feature environment's links.
#   ./tsc-dev pr-list                 List PR worktrees and their commits ahead of upstream
#   ./tsc-dev pr-rm <repo> <br>       Remove a PR worktree (add --delete-branch to drop the branch)
#   ./tsc-dev rebuild <repo> [repo..] Link local deps + build + yalc push, for each repo IN ORDER.
#                                     Use this to propagate a change up the bundling chain. Because
#                                     core/props/circuit-json are INLINED into eval's webworker, which
#                                     is INLINED into runframe's standalone bundle, you must rebuild
#                                     bottom-up. Prefer letting the chain be computed:
#                                         ./tsc-dev rebuild --from core [--to cli] [--dry-run]
#                                     which reads workspace.json's bundling graph, keeps only edges
#                                     the consumers' package.json really have, and sorts them so every
#                                     package is built after everything it inlines.
#   ./tsc-dev dev [file] [--local]   Run the CLI dev server FROM SOURCE on a circuit project.
#                                     Pass a project dir or file (e.g. ../tscircuit-local). With
#                                     --local it serves YOUR locally-built runframe standalone
#                                     (reflecting local core/eval/runframe changes); without it,
#                                     the cli's installed (published) packages are used.
#   ./tsc-dev fork <repo...>          Create your fork of each repo and wire it up as the `fork`
#                                     remote, keeping origin pointed at tscircuit. --org <org> forks
#                                     into an organization. No-op if you already have push access.
#   ./tsc-dev gen-map [--check]       Regenerate MAP.md's group sections from workspace.json (or
#                                     verify they are in sync, for CI / pre-commit)
#   ./tsc-dev test [path...]          Run the workspace's own tests (bun test ./test/)
#   ./tsc-dev pkgname <repo>          Print the npm package name a repo publishes
#   ./tsc-dev status                  List cloned repos, their package names, and active yalc links
#   ./tsc-dev sync-forks [repo...]    Update each fork to head of upstream main with your patches on
#                                     top: rebase the repo's patch branch in an isolated worktree,
#                                     force-with-lease push to `fork`, and `gh repo sync` the fork's
#                                     main. Defaults to the parametric-enclosure repos from
#                                     create-fdm-enclosure/README.md: circuit-json props
#                                     create-fdm-enclosure circuit-json-to-gltf
#                                     infer-cable-insertion-point 3d-viewer core rfc. Each uses
#                                     `feat/parametric-enclosures` except infer-cable-insertion-point
#                                     (`fix/explicit-insertion-direction`); set SYNC_FORK_BRANCH to
#                                     force one branch for every repo. Needs `gh`.
#
# LOCAL VERSIONS: publish/push/watch/rebuild stamp package.json with a throwaway
# prerelease version — `0.0.4` is published to the yalc store as
# `0.0.4-local.20260805T094955` — then restore package.json, so the working tree
# stays clean. This exists because versions are assigned by CI (`pver release` in
# bun-pver-release.yml bumps package.json, publishes to npm, and commits `vX.Y.Z`
# back to main), which means a fresh checkout's version is *exactly* the released
# artifact's version. Building locally from it produces a different package that
# claims the same version — and since both the yalc store (~/.yalc/packages/<pkg>/
# <version>) and bun's cache are keyed by version, the two silently substitute for
# one another. A `-local.` prerelease sorts below every release, so it can never
# collide with, or satisfy a range for, anything npm will ever mint.
# Set TSC_DEV_NO_STAMP=1 to publish the literal package.json version instead.
#
# Examples:
#   # Just hack on core (no yalc needed — core tests are self-contained):
#   ./tsc-dev clone core && ./tsc-dev install core
#   cd core && bun test
#
#   # Edit `props` and test the change inside `core`:
#   ./tsc-dev clone core props
#   ./tsc-dev install core props
#   ./tsc-dev publish props          # build props + publish to local yalc store
#   ./tsc-dev link core props        # core now uses your local props
#   cd core && bun test
#   # after editing props again:
#   ../tsc-dev push props            # rebuild + push to core automatically
#
set -euo pipefail

ORG="https://github.com/tscircuit"
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_CACHE="$ROOT/.tscircuit-repos.txt"  # active org repo names, one per line
MANIFEST="$ROOT/workspace.json"          # shared config: groups, bundling graph, fork efforts

# Evaluate a JS expression against the manifest with `w` bound to it. Arrays
# print one element per line so callers can read them with `while read`.
ws() {
  [ -f "$MANIFEST" ] || die "missing $MANIFEST"
  local expr="$1"; shift
  node "$ROOT/bin/ws.mjs" "$ROOT" "$expr" "$@"
}

# Curated categories for `clone-group`, from workspace.json.
group_repos() {
  local repos; repos="$(ws "(w.groups[args[0]]||{}).repos" "$1" 2>/dev/null | tr '\n' ' ')"
  [ -n "${repos// /}" ] || return 1
  echo "$repos"
}

# The bottom-up rebuild order for a change in <from> (see bin/rebuild-chain.mjs).
rebuild_chain() {
  node "$ROOT/bin/rebuild-chain.mjs" "$ROOT" "$1" ${2:+"$2"}
}

# The default set for `clone`: the runtime rendering chain plus common leaves.
default_repos() { ws "w.defaultRepos"; }

# Find the cloned repo dir that publishes a given npm package name (empty if none).
repo_for_pkg() {
  local want="$1" d r n
  for d in "$ROOT"/*/; do
    [ -d "$d/.git" ] || continue
    r="$(basename "$d")"
    n="$(node -p "require('$d/package.json').name" 2>/dev/null)" || continue
    if [ "$n" = "$want" ]; then echo "$r"; return 0; fi
  done
  return 0
}

# Print the dependency package names (deps + devDeps + peerDeps) of a repo.
dep_names() {
  node -e "let p=require('$ROOT/$1/package.json');console.log(Object.keys({...p.dependencies,...p.devDependencies,...p.peerDependencies}).join('\n'))" 2>/dev/null
}

die() { echo "error: $*" >&2; exit 1; }
have() { [ -d "$ROOT/$1/.git" ]; }

# Read the npm package name a cloned repo publishes (handles scoped + unscoped).
pkgname() {
  local repo="$1"
  have "$repo" || die "repo '$repo' is not cloned (try: ./tsc-dev clone $repo)"
  node -p "require('$ROOT/$repo/package.json').name" 2>/dev/null \
    || die "could not read package name for '$repo'"
}

# Does the repo define a build script in package.json?
has_build() {
  node -e "process.exit(require('$ROOT/$1/package.json').scripts?.build?0:1)" 2>/dev/null
}

# Read a top-level field from a package.json (empty if the file/field is absent).
pj_field() {
  [ -f "$1" ] || return 0
  node -e 'const fs=require("fs");try{const p=JSON.parse(fs.readFileSync(process.argv[1],"utf8"));process.stdout.write(String(p[process.argv[2]]??""))}catch(e){}' "$1" "$2"
}

# ---------------------------------------------------------------------------
# Local version stamping
#
# Versions in this ecosystem are minted by CI, not by hand: bun-pver-release.yml
# runs `pver release` on every push to main, which bumps package.json, publishes
# to npm, and commits the bump back as `vX.Y.Z` (e.g. create-fdm-enclosure
# ad0d5be, author `GitHub Actions <actions@github.com>`). A fresh checkout's
# version therefore names the *published artifact*, so a local build from that
# checkout is a different package wearing the same version string. That is not
# merely confusing: the yalc store is keyed by version
# (~/.yalc/packages/<pkg>/<version>) and so is bun's cache, so the local and
# published builds occupy the same slot and substitute for each other silently.
#
# Fix: publish under a throwaway prerelease, `0.0.4` -> `0.0.4-local.<stamp>`.
# A prerelease sorts *below* its release (`0.0.4-local.1` < `0.0.4`) and
# satisfies no ordinary range, so it can never be confused with, or accepted in
# place of, anything npm will ever mint. package.json is restored from a byte
# copy afterwards, so the working tree never carries a fake version into a diff
# (the same hazard class as a leftover yalc link).
#
# Consequence to expect: `bun install` prints `warn: incorrect peer dependency`
# for stamped packages, because a prerelease does not satisfy a caret range.
# That warning is already routine in this workspace and is advisory only.
# ---------------------------------------------------------------------------
STAMP_PJ=""; STAMP_BAK=""

stamp_restore() {
  [ -n "$STAMP_BAK" ] || return 0
  [ -f "$STAMP_BAK" ] && cp "$STAMP_BAK" "$STAMP_PJ"
  rm -f "$STAMP_BAK"
  STAMP_PJ=""; STAMP_BAK=""
}

# with_dev_version <repo> <cmd> [args...] — run <cmd> with <repo>/package.json
# temporarily bearing a `-local.<stamp>` version. Restored via trap on Ctrl-C
# too, so an interrupted `watch` cannot leave a fake version behind.
with_dev_version() {
  local repo="$1"; shift
  local pj="$ROOT/$repo/package.json" real base stamped rc=0
  real="$(pj_field "$pj" version)"
  if [ "${TSC_DEV_NO_STAMP:-0}" = 1 ] || [ -z "$real" ]; then "$@"; return; fi
  base="${real%%-local.*}"   # also re-stamps cleanly if a previous run crashed
  stamped="$base-local.$(date +%Y%m%dT%H%M%S)"
  STAMP_PJ="$pj"; STAMP_BAK="$(mktemp "${TMPDIR:-/tmp}/tsc-dev-pj.XXXXXX")"
  cp "$pj" "$STAMP_BAK"
  trap 'stamp_restore' EXIT INT TERM
  # Patch the version in place rather than re-serialising, so the published
  # package.json is byte-identical to the repo's apart from that one string.
  node -e 'const fs=require("fs");const f=process.argv[1];const s=fs.readFileSync(f,"utf8");fs.writeFileSync(f,s.replace(/("version"\s*:\s*")[^"]*"/,`$1${process.argv[2]}"`))' "$pj" "$stamped"
  echo "  ⊙ local version $stamped  (package.json restored to $base afterwards)"
  "$@" || rc=$?
  stamp_restore
  trap - EXIT INT TERM
  return $rc
}

# Package names a consumer currently has linked, from its yalc.lock.
yalc_lock_pkgs() {
  node -e 'const fs=require("fs");try{const l=JSON.parse(fs.readFileSync(process.argv[1]+"/yalc.lock","utf8"));process.stdout.write(Object.keys(l.packages||{}).join("\n"))}catch(e){}' "$1"
}

# Every directory yalc has ever installed a package into (the store's own view).
yalc_installations() {
  node -e 'const fs=require("fs"),os=require("os");try{const i=JSON.parse(fs.readFileSync(os.homedir()+"/.yalc/installations.json","utf8"));process.stdout.write([...new Set(Object.values(i).flat())].sort().join("\n"))}catch(e){}'
}

cmd_clone() {
  local repos=("$@")
  if [ ${#repos[@]} -eq 0 ]; then
    while IFS= read -r r; do [ -n "$r" ] && repos+=("$r"); done < <(default_repos)
  fi
  for r in "${repos[@]}"; do
    if have "$r"; then echo "✓ $r already cloned"; continue; fi
    echo "▶ cloning $r"
    git clone "$ORG/$r" "$ROOT/$r"
  done
}

# Is a name an active repo in the tscircuit org? (uses the cached list)
is_org_repo() {
  [ -f "$REPO_CACHE" ] || gh repo list tscircuit --no-archived --limit 1000 --source --json name --jq '.[].name' 2>/dev/null | sort > "$REPO_CACHE"
  grep -qxF "$1" "$REPO_CACHE"
}

cmd_clone_group() {
  local g="${1:-}"
  if [ -z "$g" ]; then
    echo "available groups (from workspace.json):"
    local name
    while IFS= read -r name; do
      [ -n "$name" ] || continue
      printf '  %-12s %s\n' "$name" "$(ws "w.groups[args[0]].description" "$name")"
      printf '  %-12s   %s\n' "" "$(ws "w.groups[args[0]].repos.join(' ')" "$name")"
    done < <(ws "Object.keys(w.groups)")
    echo "usage: ./tsc-dev clone-group <group>"; return 0
  fi
  local repos; repos="$(group_repos "$g")" || die "unknown group '$g' (run ./tsc-dev clone-group)"
  cmd_clone $repos
}

cmd_clone_deps() {
  local recursive=0 start=""
  for a in "$@"; do
    case "$a" in -r|--recursive) recursive=1 ;; *) start="$a" ;; esac
  done
  [ -n "$start" ] || die "usage: clone-deps <repo> [-r|--recursive]"
  have "$start" || die "repo '$start' is not cloned (clone it first)"
  local queue=("$start") seen=" " repo dep cand
  while [ ${#queue[@]} -gt 0 ]; do
    repo="${queue[0]}"; queue=("${queue[@]:1}")
    case "$seen" in *" $repo "*) continue ;; esac
    seen="$seen$repo "
    have "$repo" || { echo "▶ cloning $repo"; git clone -q "$ORG/$repo" "$ROOT/$repo"; }
    # derive candidate org repo names from this repo's dependencies
    while IFS= read -r dep; do
      [ -n "$dep" ] || continue
      cand="${dep#@tscircuit/}"        # strip scope; unscoped names pass through
      case "$cand" in @*/*) continue ;; esac   # skip other scopes (@types/... etc.)
      is_org_repo "$cand" || continue
      # For unscoped deps, confirm the org repo actually publishes THIS package
      # (guards against name collisions like the npm `react` vs tscircuit/react).
      if [ "$dep" = "$cand" ] && ! have "$cand"; then
        local published
        published="$(curl -sL "https://raw.githubusercontent.com/tscircuit/$cand/HEAD/package.json" 2>/dev/null | node -p "try{JSON.parse(require('fs').readFileSync(0)).name}catch(e){''}" 2>/dev/null)"
        [ "$published" = "$dep" ] || { echo "  ⚠ skip $dep (org/$cand publishes '$published')"; continue; }
      fi
      if ! have "$cand"; then
        echo "  ↳ dep $dep -> cloning $cand"; git clone -q "$ORG/$cand" "$ROOT/$cand"
      fi
      [ "$recursive" = 1 ] && queue+=("$cand")
    done < <(dep_names "$repo")
  done
  echo "✓ dependency closure of '$start' cloned (recursive=$recursive)"
}

cmd_search() {
  [ $# -ge 1 ] || die "usage: search <pattern> [extra rg args]"
  local dirs=()
  for d in "$ROOT"/*/; do [ -d "$d/.git" ] && dirs+=("$d"); done
  [ ${#dirs[@]} -gt 0 ] || die "no repos cloned yet"
  # search source only; skip build output and deps
  rg --line-number --glob '!**/{node_modules,dist,.git,cosmos-export,benchmarking-dist}/**' "$@" "${dirs[@]}"
}

cmd_install() {
  local repos=("$@")
  if [ ${#repos[@]} -eq 0 ]; then
    repos=(); for d in "$ROOT"/*/; do [ -d "$d/.git" ] && repos+=("$(basename "$d")"); done
  fi
  for r in "${repos[@]}"; do
    echo "▶ bun install ($r)"; (cd "$ROOT/$r" && bun install)
  done
}

do_build_publish() {
  local repo="$1"
  if has_build "$repo"; then
    echo "▶ build ($repo)"; (cd "$ROOT/$repo" && bun run build)
  else
    echo "ℹ $repo has no build script (source-only package) — publishing as-is"
  fi
  echo "▶ yalc publish ($repo -> $(pkgname "$repo"))"
  (cd "$ROOT/$repo" && yalc publish)
}

cmd_publish() {
  local repo="${1:?usage: publish <repo>}"
  have "$repo" || die "repo '$repo' is not cloned"
  with_dev_version "$repo" do_build_publish "$repo"
}

do_watch() {
  local repo="$1"
  has_build "$repo" && (cd "$ROOT/$repo" && bun run build) || true
  echo "▶ yalc publish --watch ($repo). NOTE: rebuild manually if it has a build step."
  (cd "$ROOT/$repo" && yalc publish --watch)
}

cmd_watch() {
  local repo="${1:?usage: watch <repo>}"
  have "$repo" || die "repo '$repo' is not cloned"
  # The stamp is held for the whole watch session (one version for the session,
  # republished in place on each change) and released by the trap on Ctrl-C.
  with_dev_version "$repo" do_watch "$repo"
}

cmd_link() {
  local consumer="${1:?usage: link <consumer> <dep>}"
  local dep="${2:?usage: link <consumer> <dep>}"
  have "$consumer" || die "consumer '$consumer' is not cloned"
  local name; name="$(pkgname "$dep")"
  echo "▶ yalc add $name (in $consumer)"
  (cd "$ROOT/$consumer" && yalc add "$name")
}

do_build_push() {
  local repo="$1"
  has_build "$repo" && { echo "▶ build ($repo)"; (cd "$ROOT/$repo" && bun run build); }
  echo "▶ yalc push ($repo -> $(pkgname "$repo"))"
  (cd "$ROOT/$repo" && yalc push)
}

cmd_push() {
  local repo="${1:?usage: push <repo>}"
  have "$repo" || die "repo '$repo' is not cloned"
  with_dev_version "$repo" do_build_push "$repo"
}

cmd_unlink() {
  local consumer="${1:?usage: unlink <consumer>}"
  have "$consumer" || die "consumer '$consumer' is not cloned"
  echo "▶ yalc remove --all + bun install (in $consumer)"
  (cd "$ROOT/$consumer" && yalc remove --all || true; bun install)
}

cmd_rebuild() {
  local from="" to="" dry=0 repos=() r
  while [ $# -gt 0 ]; do
    case "$1" in
      --from) from="${2:?--from needs a repo}"; shift 2 ;;
      --to) to="${2:?--to needs a repo}"; shift 2 ;;
      --dry-run|-n) dry=1; shift ;;
      -*) die "unknown flag '$1'" ;;
      *) repos+=("$1"); shift ;;
    esac
  done
  if [ -n "$from" ]; then
    [ ${#repos[@]} -eq 0 ] || die "--from and an explicit repo list are mutually exclusive"
    have "$from" || die "repo '$from' is not cloned"
    # rebuild-chain.mjs reports its own specific failure (not downstream, cycle)
    # on stderr; don't paper over it with a vaguer message.
    local chain_out chain_rc=0
    chain_out="$(rebuild_chain "$from" "$to")" || chain_rc=$?
    [ "$chain_rc" -eq 0 ] || exit "$chain_rc"
    while IFS= read -r r; do [ -n "$r" ] && repos+=("$r"); done <<< "$chain_out"
    [ ${#repos[@]} -gt 0 ] || die "'$from' is not in workspace.json's bundling graph"
    echo "▶ chain from $from: ${repos[*]}"
  fi
  [ ${#repos[@]} -ge 1 ] || die "usage: rebuild <repo> [repo ...] | rebuild --from <repo> [--to <repo>] [--dry-run]"
  if [ "$dry" = 1 ]; then
    printf '%s\n' "(dry run) would rebuild in order: ${repos[*]}"
    return 0
  fi
  local repo dep name
  for repo in "${repos[@]}"; do
    have "$repo" || die "repo '$repo' is not cloned"
    echo "=== rebuilding $repo ($(pkgname "$repo")) ==="
    # Link any dependency that is also a cloned repo in this workspace.
    while IFS= read -r dep; do
      [ -n "$dep" ] || continue
      name="$(repo_for_pkg "$dep")"
      [ -n "$name" ] || continue            # dep is not a local repo
      [ "$name" = "$repo" ] && continue      # don't self-link
      echo "  ↳ yalc add $dep (local)"
      (cd "$ROOT/$repo" && yalc add "$dep" >/dev/null)
    done < <(dep_names "$repo")
    # Build (re-inlines any linked deps) then push to downstream consumers.
    # Stamping starts here, AFTER the `yalc add` loop above: the stamp restores
    # package.json from a backup, which would otherwise revert those links.
    with_dev_version "$repo" do_rebuild_one "$repo"
  done
  echo "✓ rebuilt: ${repos[*]}"
}

do_rebuild_one() {
  local repo="$1"
  if has_build "$repo"; then
    echo "  ↳ bun run build"; (cd "$ROOT/$repo" && bun run build)
  fi
  echo "  ↳ yalc push"; (cd "$ROOT/$repo" && yalc push)
}

# Audit yalc links from the CONSUMER side — the three ways a link goes wrong:
#   1. the linked build claims a version npm can also publish (the collision this
#      whole stamping scheme exists to prevent);
#   2. node_modules holds a plain npm copy, i.e. an install silently replaced the
#      link (no yalcSig present);
#   3. node_modules is a yalc copy but an older one than .yalc/ (missed push).
cmd_doctor() {
  local targets=("$@") t dir problems=0 checked=0
  if [ ${#targets[@]} -eq 0 ]; then
    while IFS= read -r t; do [ -n "$t" ] && [ -d "$t" ] && targets+=("$t"); done < <(yalc_installations)
  fi
  [ ${#targets[@]} -gt 0 ] || { echo "no yalc-linked projects found"; return 0; }
  # package name -> workspace repo, built once (a node start per repo is slow to
  # repeat for every link).
  local index; index="$(mktemp "${TMPDIR:-/tmp}/tsc-dev-idx.XXXXXX")"
  local d r n
  for d in "$ROOT"/*/; do
    [ -d "$d/.git" ] || continue
    r="$(basename "$d")"
    n="$(pj_field "$d/package.json" name)"
    [ -n "$n" ] && printf '%s\t%s\n' "$n" "$r" >> "$index"
  done
  for t in "${targets[@]}"; do
    if have "$t"; then dir="$ROOT/$t"
    elif [ -d "$t" ]; then dir="$(cd "$t" && pwd)"
    else echo "⚠ $t: not a cloned repo or a directory"; continue; fi
    [ -f "$dir/yalc.lock" ] || continue
    echo "• ${dir/#$HOME/~}"
    local name ydir nmdir yver ysig nver nsig owner
    while IFS= read -r name; do
      [ -n "$name" ] || continue
      checked=$((checked + 1))
      owner="$(grep -F "$(printf '%s\t' "$name")" "$index" 2>/dev/null | head -1 | cut -f2)"
      ydir="$dir/.yalc/$name"; nmdir="$dir/node_modules/$name"
      yver="$(pj_field "$ydir/package.json" version)"
      ysig="$(pj_field "$ydir/package.json" yalcSig)"
      nver="$(pj_field "$nmdir/package.json" version)"
      nsig="$(pj_field "$nmdir/package.json" yalcSig)"
      if [ -z "$yver" ]; then
        printf '    ✗ %-38s no .yalc payload — run: (cd %s && yalc add %s)\n' "$name" "$dir" "$name"
        problems=$((problems + 1)); continue
      fi
      if [ -z "$nver" ]; then
        printf '    ✗ %-38s linked but not installed — run: (cd %s && bun install)\n' "$name" "$dir"
        problems=$((problems + 1)); continue
      fi
      # No yalcSig in node_modules => a registry tarball, not the link. This is
      # the silent failure: an install resolved the name from cache/npm and the
      # local build vanished without any error.
      if [ -z "$nsig" ]; then
        printf '    ✗ %-38s node_modules holds an npm copy (%s), not the link — run: (cd %s && yalc add %s)\n' \
          "$name" "$nver" "$dir" "$name"
        problems=$((problems + 1)); continue
      fi
      if [ "$nsig" != "$ysig" ]; then
        printf '    ✗ %-38s stale: node_modules %s != .yalc %s — re-push the producing repo\n' \
          "$name" "$nver" "$yver"
        problems=$((problems + 1)); continue
      fi
      case "$yver" in
        *-local.*) printf '    ✓ %-38s %s\n' "$name" "$yver" ;;
        *)
          printf '    ⚠ %-38s %s — unstamped: this local build claims a version npm can also mint. Re-publish: ./tsc-dev push %s\n' \
            "$name" "$yver" "${owner:-<repo>}"
          problems=$((problems + 1)) ;;
      esac
    done < <(yalc_lock_pkgs "$dir")
  done
  rm -f "$index"
  if [ "$problems" -eq 0 ]; then
    echo "✓ $checked link(s) checked, no problems"
  else
    echo "✗ $checked link(s) checked, $problems problem(s)"
    return 1
  fi
}

# Stamped versions each get their own store directory, so the store grows one
# entry per publish. Prune only `-local.*` entries: a released version in the
# store may be a legitimate `yalc add <pkg>@<version>` pin.
cmd_prune_store() {
  local store="$HOME/.yalc/packages" keep=2 filters=() pkgdirs=() d s rel
  while [ $# -gt 0 ]; do
    case "$1" in
      --keep) keep="${2:?usage: prune-store [--keep N] [pkg...]}"; shift 2 ;;
      --keep=*) keep="${1#*=}"; shift ;;
      *) filters+=("$1"); shift ;;
    esac
  done
  [ -d "$store" ] || { echo "no yalc store at $store"; return 0; }
  for d in "$store"/*/; do
    [ -d "$d" ] || continue
    case "$(basename "$d")" in
      @*) for s in "$d"*/; do [ -d "$s" ] && pkgdirs+=("$s"); done ;;
      *) pkgdirs+=("$d") ;;
    esac
  done
  [ ${#pkgdirs[@]} -gt 0 ] || { echo "yalc store is empty"; return 0; }
  local removed=0 kept=0 name vers n i f match
  for d in "${pkgdirs[@]}"; do
    rel="${d#$store/}"; name="${rel%/}"
    if [ ${#filters[@]} -gt 0 ]; then
      match=0
      for f in "${filters[@]}"; do [ "$f" = "$name" ] && match=1; done
      [ "$match" = 1 ] || continue
    fi
    vers=()
    while IFS= read -r s; do [ -n "$s" ] && vers+=("$s"); done < <(ls -1 "$d" 2>/dev/null | grep -- '-local\.' | sort)
    n=${#vers[@]}
    if [ "$n" -le "$keep" ]; then kept=$((kept + n)); continue; fi
    i=0
    while [ "$i" -lt $((n - keep)) ]; do
      rm -rf "$d/${vers[$i]}"
      echo "  ✗ rm $name@${vers[$i]}"
      removed=$((removed + 1)); i=$((i + 1))
    done
    kept=$((kept + keep))
  done
  echo "✓ removed $removed stale local build(s), kept $kept (released versions untouched)"
}

cmd_dev() {
  have cli || die "clone+install the cli first: ./tsc-dev clone cli && ./tsc-dev install cli"
  local cli_main="$ROOT/cli/cli/main.ts"
  [ -f "$cli_main" ] || die "cli entry not found at $cli_main (is the cli repo cloned?)"
  local arg="" local_runframe=0
  local passthru=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --local) local_runframe=1 ;;
      -*) passthru+=("$1") ;;
      *) if [ -z "$arg" ]; then arg="$1"; else passthru+=("$1"); fi ;;
    esac
    shift
  done
  [ -n "$arg" ] || arg="$PWD"
  local projdir file=""
  if [ -d "$arg" ]; then
    projdir="$(cd "$arg" && pwd)"
  elif [ -f "$arg" ]; then
    projdir="$(cd "$(dirname "$arg")" && pwd)"; file="$(basename "$arg")"
  else
    die "no such project dir or file: $arg"
  fi
  # --local: serve YOUR workspace's locally-built runframe standalone (which embeds
  # your local eval+core after `./tsc-dev rebuild core eval runframe`). The cli
  # re-reads this file on every request, so after rebuilding runframe you just
  # refresh the browser — no restart needed.
  if [ "$local_runframe" = 1 ]; then
    local sa="$ROOT/runframe/dist/standalone.min.js"
    local worker="$ROOT/eval/dist/webworker/entrypoint.js"
    [ -f "$sa" ] || die "local runframe not built. First run: ./tsc-dev rebuild core eval runframe"
    local served="$sa"
    # The raw runframe standalone has an UNFILLED eval-worker placeholder (the
    # tscircuit umbrella normally fills it). If we don't fill it, the browser
    # falls back to the CDN/published eval — not our rebuilt one. Fill it with
    # the local eval webworker so `tsci dev --local` truly uses local eval+core.
    if [ -f "$worker" ] && grep -q "INJECT_TSCIRCUIT_EVAL_WEB_WORKER_BLOB_URL" "$sa"; then
      served="$ROOT/runframe/dist/standalone.local.min.js"
      node -e 'const fs=require("fs");const sa=fs.readFileSync(process.argv[1],"utf8");const w=fs.readFileSync(process.argv[2],"utf8");const b=Buffer.from(w).toString("base64");const e=`URL.createObjectURL(new Blob([atob("${b}")],{type:"application/javascript"}))`;fs.writeFileSync(process.argv[3], sa.replace(/"<--INJECT_TSCIRCUIT_EVAL_WEB_WORKER_BLOB_URL-->"/g,e));' "$sa" "$worker" "$served"
      echo "  ⊙ filled eval-worker placeholder with local eval"
    fi
    export RUNFRAME_STANDALONE_FILE_PATH="$served"
    echo "  ⊙ serving LOCAL runframe: $served"
  fi
  # Run with cwd = the project (mimics `tsci dev`): projectDir resolves correctly,
  # your package.json/tscircuit.config/entrypoint are respected, and bun still
  # resolves the cli's own lib/* aliases from cli/tsconfig.json. Extra flags
  # (e.g. --port 3030) are forwarded to `tsci dev`.
  echo "▶ tsci dev (from source) in $projdir${file:+  (file: $file)}"
  (cd "$projdir" && exec bun --hot "$cli_main" dev ${file:+"$file"} ${passthru[@]+"${passthru[@]}"})
}

cmd_status() {
  for d in "$ROOT"/*/; do
    [ -d "$d/.git" ] || continue
    local r; r="$(basename "$d")"
    local name; name="$(node -p "require('$d/package.json').name" 2>/dev/null || echo '?')"
    printf '• %-28s %s\n' "$r" "$name"
    if [ -f "$d/yalc.lock" ]; then
      node -p "Object.keys(require('$d/yalc.lock').packages||{}).map(p=>'    ↳ linked: '+p).join('\n')" 2>/dev/null || true
    fi
  done
}

# ---------------------------------------------------------------------------
# Isolated PR worktrees
#
# Feature work here routinely turns up a small, self-contained upstream bug that
# deserves its own PR immediately. Fixing it in your feature checkout is bad on
# both ends: the PR picks up unrelated feature commits and yalc-dirtied
# package.json, and testing it churns the build/link state you had set up.
#
# `pr` gives that fix its own git worktree off upstream main, in .worktrees/,
# which is isolated in the three ways that matter here:
#   1. separate checkout — your feature branch, and its dirty tree, are untouched;
#   2. separate node_modules — `bun install` in the worktree, no shared state;
#   3. no yalc links — package.json comes from upstream main, so it carries none
#      by construction. (A worktree must NOT `yalc publish` to the shared store,
#      which is global and would overwrite what your feature env is using. Use
#      `pr-link`, which keeps a private store inside the worktree.)
# ---------------------------------------------------------------------------
WT_ROOT="$ROOT/.worktrees"

wt_dir() { echo "$WT_ROOT/$1/$2"; }

# The upstream default branch (main here, master in a few older repos).
origin_head() {
  local repo="$1" ref
  ref="$(git -C "$ROOT/$repo" symbolic-ref --quiet refs/remotes/origin/HEAD 2>/dev/null || true)"
  if [ -n "$ref" ]; then echo "origin/${ref##*/}"; return 0; fi
  if git -C "$ROOT/$repo" show-ref --verify --quiet refs/remotes/origin/main; then
    echo "origin/main"
  else
    echo "origin/master"
  fi
}

# The commands CI actually runs on a pull request (see bin/ci-gates.mjs).
ci_gates() {
  node "$ROOT/bin/ci-gates.mjs" "$1"
}

cmd_pr() {
  local repo="" branch="" base="" no_install=0
  local picks=() takes=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --base) base="${2:?--base needs a ref}"; shift 2 ;;
      --pick) picks+=("${2:?--pick needs a commit}"); shift 2 ;;
      --take) takes+=("${2:?--take needs a path}"); shift 2 ;;
      --no-install) no_install=1; shift ;;
      -*) die "unknown flag '$1'" ;;
      *) if [ -z "$repo" ]; then repo="$1"; elif [ -z "$branch" ]; then branch="$1"; else die "unexpected argument '$1'"; fi; shift ;;
    esac
  done
  [ -n "$repo" ] && [ -n "$branch" ] \
    || die "usage: pr <repo> <branch> [--base <ref>] [--pick <commit>]... [--take <path>]... [--no-install]"
  have "$repo" || die "repo '$repo' is not cloned"
  local src="$ROOT/$repo" dir; dir="$(wt_dir "$repo" "$branch")"
  [ -e "$dir" ] && die "worktree already exists: $dir  (remove: ./tsc-dev pr-rm $repo $branch)"

  echo "▶ fetch origin ($repo)"
  git -C "$src" fetch origin --quiet || die "fetch failed"
  [ -n "$base" ] || base="$(origin_head "$repo")"
  git -C "$src" rev-parse --verify --quiet "$base" >/dev/null || die "no such base ref: $base"

  mkdir -p "$(dirname "$dir")"
  if git -C "$src" show-ref --verify --quiet "refs/heads/$branch"; then
    echo "▶ worktree $repo:$branch (existing branch) -> ${dir/#$HOME/~}"
    git -C "$src" worktree add --quiet "$dir" "$branch"
  else
    echo "▶ worktree $repo:$branch off $base ($(git -C "$src" rev-parse --short "$base")) -> ${dir/#$HOME/~}"
    git -C "$src" worktree add --quiet -b "$branch" "$dir" "$base"
  fi

  local p failed_pick=0
  if [ ${#picks[@]} -gt 0 ]; then
    for p in "${picks[@]}"; do
      if git -C "$dir" cherry-pick "$p" >/dev/null 2>&1; then
        echo "  ↳ cherry-picked $(git -C "$src" rev-parse --short "$p")  $(git -C "$src" log -1 --format=%s "$p")"
      else
        git -C "$dir" cherry-pick --abort 2>/dev/null || true
        echo "  ✗ cherry-pick $p conflicts with $base — the fix depends on feature work."
        echo "      Either land the prerequisite first, or re-apply by hand: --take <path>"
        failed_pick=1
      fi
    done
  fi

  if [ ${#takes[@]} -gt 0 ]; then
    for p in "${takes[@]}"; do
      # package.json in a feature checkout is yalc-dirtied (file:.yalc/ deps);
      # copying it would put local links in the PR.
      case "$(basename "$p")" in
        package.json) echo "  ⚠ refusing --take package.json (it carries yalc file:.yalc/ links) — edit it in the worktree instead"; continue ;;
      esac
      [ -e "$src/$p" ] || { echo "  ⚠ no such path in $repo: $p"; continue; }
      mkdir -p "$dir/$(dirname "$p")"
      cp -R "$src/$p" "$dir/$p"
      echo "  ↳ took $p from your working tree (uncommitted)"
    done
  fi

  if [ "$no_install" = 0 ]; then
    echo "▶ bun install (worktree-local node_modules)"
    (cd "$dir" && bun install)
  fi
  if grep -q '"file:\.yalc/' "$dir/package.json" 2>/dev/null; then
    echo "  ⚠ this worktree's package.json contains yalc links — remove them before pushing"
  fi

  echo "✓ isolated worktree ready: $dir"
  echo "    cd $dir"
  echo "    ./tsc-dev pr-check $repo $branch      # run exactly the gates CI runs on a PR"
  echo "    ./tsc-dev pr-push  $repo $branch      # push to your fork (or origin) + open the PR"
  [ "$failed_pick" = 1 ] && return 1
  return 0
}

# Run the repo's own PR gates inside the worktree. Cheaper than pushing and
# waiting for CI, and it catches the repo-specific gates (lint:zod,
# format:check, smoke-test:dist) that the generic test+typecheck pair misses.
cmd_pr_check() {
  local repo="${1:?usage: pr-check <repo> <branch>}" branch="${2:?usage: pr-check <repo> <branch>}"
  have "$repo" || die "repo '$repo' is not cloned"
  local dir; dir="$(wt_dir "$repo" "$branch")"
  [ -d "$dir" ] || die "no worktree at $dir  (create it: ./tsc-dev pr $repo $branch)"
  [ -d "$dir/node_modules" ] || { echo "▶ bun install"; (cd "$dir" && bun install); }
  local gates=() g
  while IFS= read -r g; do [ -n "$g" ] && gates+=("$g"); done < <(ci_gates "$dir")
  [ ${#gates[@]} -gt 0 ] || { echo "⚠ no pull_request-gated commands found in $repo/.github/workflows"; return 0; }
  echo "▶ ${#gates[@]} gate(s) from $repo/.github/workflows (pull_request-triggered)"
  local failed=() ok=0
  for g in "${gates[@]}"; do
    echo "=== $g"
    if (cd "$dir" && eval "$g"); then ok=$((ok + 1)); else failed+=("$g"); fi
  done
  echo "————————————————————————————————————————"
  if [ ${#failed[@]} -eq 0 ]; then
    echo "✓ $ok/${#gates[@]} gates passed in $repo:$branch"
  else
    echo "✗ $ok/${#gates[@]} gates passed; failed:"
    for g in "${failed[@]}"; do echo "    - $g"; done
    return 1
  fi
}

# Link one workspace package into a PR worktree through a PRIVATE yalc store.
# The shared store (~/.yalc) is global: publishing into it from a worktree would
# silently replace the build your feature environment is running on. --store-folder
# keeps the whole exchange inside the worktree.
cmd_pr_link() {
  local repo="${1:?usage: pr-link <repo> <branch> <dep-repo>}"
  local branch="${2:?usage: pr-link <repo> <branch> <dep-repo>}"
  local dep="${3:?usage: pr-link <repo> <branch> <dep-repo>}"
  have "$repo" || die "repo '$repo' is not cloned"
  have "$dep" || die "dep repo '$dep' is not cloned"
  local dir; dir="$(wt_dir "$repo" "$branch")"
  [ -d "$dir" ] || die "no worktree at $dir  (create it: ./tsc-dev pr $repo $branch)"
  local store="$dir/.yalc-store" name; name="$(pkgname "$dep")"
  has_build "$dep" && { echo "▶ build ($dep)"; (cd "$ROOT/$dep" && bun run build); }
  echo "▶ publish $name to the worktree's private store"
  with_dev_version "$dep" env -C "$ROOT/$dep" yalc publish --store-folder "$store"
  echo "▶ yalc add $name (in the worktree)"
  (cd "$dir" && yalc add "$name" --store-folder "$store")
  echo "⚠ remove this link before pushing:  (cd $dir && yalc remove --all && bun install)"
}

cmd_pr_list() {
  [ -d "$WT_ROOT" ] || { echo "no PR worktrees"; return 0; }
  local d repo w branch base
  for d in "$WT_ROOT"/*/; do
    [ -d "$d" ] || continue
    repo="$(basename "$d")"
    base="$(origin_head "$repo" 2>/dev/null || echo '')"
    while IFS= read -r w; do
      [ -n "$w" ] || continue
      branch="$(git -C "$w" rev-parse --abbrev-ref HEAD 2>/dev/null || echo '?')"
      printf '• %-24s %-34s %s\n' "$repo" "$branch" "${w/#$HOME/~}"
      [ -n "$base" ] && git -C "$w" log --oneline "$base..HEAD" 2>/dev/null | sed 's/^/      /'
    done < <(find "$d" -maxdepth 3 -name .git -exec dirname {} \; 2>/dev/null | sort)
  done
}

cmd_pr_rm() {
  local repo="${1:?usage: pr-rm <repo> <branch> [--delete-branch]}"
  local branch="${2:?usage: pr-rm <repo> <branch> [--delete-branch]}"
  have "$repo" || die "repo '$repo' is not cloned"
  local dir; dir="$(wt_dir "$repo" "$branch")"
  [ -d "$dir" ] || die "no worktree at $dir"
  echo "▶ removing worktree $repo:$branch"
  git -C "$ROOT/$repo" worktree remove --force "$dir"
  rmdir "$(dirname "$dir")" 2>/dev/null || true
  rmdir "$WT_ROOT/$repo" 2>/dev/null || true
  rmdir "$WT_ROOT" 2>/dev/null || true
  if [ "${3:-}" = "--delete-branch" ]; then
    git -C "$ROOT/$repo" branch -D "$branch" && echo "  ↳ deleted branch $branch"
  else
    echo "  ℹ branch $branch kept (delete with: git -C $ROOT/$repo branch -D $branch)"
  fi
}

# ---------------------------------------------------------------------------
# Contributing: forks vs. direct push
#
# Nothing user-specific belongs in this repo. The convention is:
#   origin  = github.com/tscircuit/<repo>   (upstream, same for everyone)
#   fork    = github.com/<you>/<repo>       (yours; a per-checkout git remote)
# so identity lives in each checkout's git config, which is already per-user and
# untracked. `./tsc-dev fork <repo>` creates the fork and wires that remote for
# whoever is logged into `gh`.
#
# Maintainers with push access to tscircuit/<repo> need no fork — they branch on
# origin. Both paths work here: push_remote_for picks `fork` when the remote
# exists, otherwise `origin` when GitHub reports push permission.
# ---------------------------------------------------------------------------

gh_user() {
  command -v gh >/dev/null 2>&1 || die "this needs the GitHub CLI (gh)"
  gh api user --jq .login 2>/dev/null || die "gh is not authenticated (run: gh auth login)"
}

# Does the authenticated user have push access to the upstream repo?
repo_push_access() {
  gh api "repos/tscircuit/$1" --jq '.permissions.push // false' 2>/dev/null | grep -qx true
}

# Which remote should a PR branch be pushed to?
push_remote_for() {
  local repo="$1"
  if git -C "$ROOT/$repo" remote | grep -qx fork; then echo "fork"; return 0; fi
  if repo_push_access "$repo"; then echo "origin"; return 0; fi
  return 1
}

# Create the fork (if needed) and wire it up as the `fork` remote. Idempotent.
# gh's default would rename origin->upstream and make the fork origin; we keep
# origin pointing at tscircuit so every other command in this script (and every
# other developer's checkout) means the same thing by "origin".
cmd_fork() {
  local org="" repos=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --org) org="${2:?--org needs an organization}"; shift 2 ;;
      -*) die "unknown flag '$1'" ;;
      *) repos+=("$1"); shift ;;
    esac
  done
  [ ${#repos[@]} -gt 0 ] || die "usage: fork <repo> [repo ...] [--org <org>]"
  local user; user="$(gh_user)"
  local owner="${org:-$user}" repo
  for repo in "${repos[@]}"; do
    have "$repo" || { echo "⚠ $repo: not cloned — skipping"; continue; }
    if git -C "$ROOT/$repo" remote | grep -qx fork; then
      echo "✓ $repo: fork remote already set ($(git -C "$ROOT/$repo" remote get-url fork))"
      continue
    fi
    if repo_push_access "$repo"; then
      echo "ℹ $repo: you have push access to tscircuit/$repo — no fork needed, branch on origin"
      continue
    fi
    echo "▶ forking tscircuit/$repo to $owner"
    (cd "$ROOT/$repo" && gh repo fork --remote --remote-name fork --clone=false ${org:+--org "$org"}) \
      || die "gh repo fork failed for $repo"
    echo "  ↳ fork remote: $(git -C "$ROOT/$repo" remote get-url fork)"
  done
}

# Push a PR worktree's branch to your fork (or origin) and open the PR. The head
# ref is qualified with the fork owner, which is what makes a cross-repo PR work
# for a contributor without write access.
cmd_pr_push() {
  local repo="${1:?usage: pr-push <repo> <branch> [--draft]}"
  local branch="${2:?usage: pr-push <repo> <branch> [--draft]}"
  local draft=""; [ "${3:-}" = "--draft" ] && draft="--draft"
  have "$repo" || die "repo '$repo' is not cloned"
  local dir; dir="$(wt_dir "$repo" "$branch")"
  [ -d "$dir" ] || die "no worktree at $dir  (create it: ./tsc-dev pr $repo $branch)"
  if grep -q '"file:\.yalc/' "$dir/package.json" 2>/dev/null; then
    die "$dir/package.json still contains yalc links — remove them before pushing"
  fi
  local remote; remote="$(push_remote_for "$repo")" \
    || die "no fork remote and no push access to tscircuit/$repo — run: ./tsc-dev fork $repo"
  echo "▶ push $branch -> $remote"
  git -C "$dir" push -u "$remote" "$branch"
  local head="$branch"
  if [ "$remote" = "fork" ]; then
    local url owner
    url="$(git -C "$ROOT/$repo" remote get-url fork)"
    owner="$(printf '%s' "$url" | sed -E 's#.*github\.com[:/]([^/]+)/.*#\1#')"
    head="$owner:$branch"
  fi
  echo "▶ gh pr create -R tscircuit/$repo --head $head"
  (cd "$dir" && gh pr create -R "tscircuit/$repo" --head "$head" ${draft:+$draft})
}

# ---------------------------------------------------------------------------
# The user config layer, and peer environments
#
# workspace.json is SHARED: clone groups, the bundling graph, the default clone
# set — the same values in every developer's copy, committed to main.
#
# .local/ is YOURS: a worktree on an ORPHAN branch (user/<login>) holding
# workspace.local.json (deep-merged over the shared file, and it wins) and
# workspace.lock.json (a snapshot of your whole build environment). It is
# versioned and pushed to YOUR fork, never to main. An orphan branch shares no
# history with main, so it cannot be fast-forwarded or merged into it by
# accident, and a PR branched from main can never drag it along.
#
# Because that branch lives on a fork, pointing at a colleague's fork and reading
# their lock is enough to reproduce their environment: `env adopt <owner>`.
# ---------------------------------------------------------------------------
LOCAL_DIR="$ROOT/.local"
LOCAL_CONFIG="$LOCAL_DIR/workspace.local.json"
LOCAL_LOCK="$LOCAL_DIR/workspace.lock.json"

# Count the keys of a top-level object in a JSON file. Read with fs, never
# `require`: require infers the module type from the extension, so it chokes on
# a JSON payload in a temp file with no .json suffix.
json_count() {
  node -e 'const fs=require("fs");try{const j=JSON.parse(fs.readFileSync(process.argv[1],"utf8"));process.stdout.write(String(Object.keys(j[process.argv[2]]||{}).length))}catch(e){process.stdout.write("?")}' "$1" "$2"
}

local_branch() {
  local who
  who="$(gh_user 2>/dev/null || true)"
  [ -n "$who" ] || who="$(git config user.email 2>/dev/null | cut -d@ -f1)"
  [ -n "$who" ] || who="local"
  echo "user/$who"
}

require_local_layer() {
  [ -d "$LOCAL_DIR" ] || die "no user layer yet — run: ./tsc-dev local init"
}

local_init() {
  local remote_url=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --remote) remote_url="${2:?--remote needs a git URL}"; shift 2 ;;
      *) die "unknown argument '$1'" ;;
    esac
  done
  git -C "$ROOT" rev-parse --git-dir >/dev/null 2>&1 \
    || die "the workspace itself is not a git repo (run: git init)"
  local branch; branch="$(local_branch)"
  if [ -d "$LOCAL_DIR" ]; then
    echo "✓ user layer already present ($(git -C "$LOCAL_DIR" rev-parse --abbrev-ref HEAD))"
  else
    if ! git -C "$ROOT" show-ref --verify --quiet "refs/heads/$branch"; then
      # Orphan branch via plumbing: an empty tree and a parentless commit. No
      # checkout gymnastics, and no shared history with main by construction.
      local empty commit
      empty="$(git -C "$ROOT" hash-object -t tree /dev/null)"
      commit="$(git -C "$ROOT" commit-tree "$empty" -m "Start user config layer")"
      git -C "$ROOT" branch "$branch" "$commit"
      echo "▶ created orphan branch $branch (no shared history with main)"
    fi
    git -C "$ROOT" worktree add --quiet "$LOCAL_DIR" "$branch"
    echo "▶ user layer worktree: .local ($branch)"
  fi
  [ -n "$remote_url" ] && local_remote "$remote_url"
  [ -f "$LOCAL_CONFIG" ] || node "$ROOT/bin/workspace-config.mjs" --seed "$ROOT" "$LOCAL_CONFIG"
  echo "    ./tsc-dev config         # effective config + which layer each key came from"
  echo "    ./tsc-dev freeze         # snapshot this build environment into the layer"
  echo "    ./tsc-dev local save     # commit + push to your fork"
}

local_remote() {
  local url="${1:?usage: local remote <git-url>}"
  if git -C "$ROOT" remote | grep -qx fork; then
    git -C "$ROOT" remote set-url fork "$url"
  else
    git -C "$ROOT" remote add fork "$url"
  fi
  echo "▶ workspace fork remote: $url"
}

# Where a user branch may be pushed. The invariant is not "anywhere but origin"
# — it is that a user/* branch must never reach the ORG's shared repo. Until
# this workspace is upstreamed to github.com/tscircuit, your own repo is both
# the home of main and the home of your user branch, and pushing there is right.
local_push_remote() {
  if git -C "$ROOT" remote | grep -qx fork; then echo "fork"; return 0; fi
  local origin_url
  origin_url="$(git -C "$ROOT" remote get-url origin 2>/dev/null || echo)"
  [ -n "$origin_url" ] || return 1
  case "$origin_url" in
    *github.com[:/]tscircuit/*) return 1 ;;   # the org's shared repo
    *) echo "origin" ;;
  esac
}

local_save() {
  local msg="Update user workspace layer"
  [ "${1:-}" = "-m" ] && { msg="${2:?-m needs a message}"; shift 2; }
  require_local_layer
  git -C "$LOCAL_DIR" add -A
  if git -C "$LOCAL_DIR" diff --cached --quiet; then
    echo "✓ nothing to save"
  else
    git -C "$LOCAL_DIR" commit -q -m "$msg"
    echo "▶ committed: $msg"
  fi
  local branch remote
  branch="$(git -C "$LOCAL_DIR" rev-parse --abbrev-ref HEAD)"
  if remote="$(local_push_remote)"; then
    git -C "$LOCAL_DIR" push -q -u "$remote" "HEAD:refs/heads/$branch" \
      && echo "▶ pushed $branch to $remote"
  else
    echo "ℹ nowhere to push this branch (origin is the org's shared repo)."
    echo "    Set your own: ./tsc-dev local remote git@github.com:<you>/tscircuit-workspace.git"
  fi
}

local_sync() {
  require_local_layer
  local remote branch
  remote="$(local_push_remote)" || die "no remote for your layer (./tsc-dev local remote <git-url>)"
  branch="$(git -C "$LOCAL_DIR" rev-parse --abbrev-ref HEAD)"
  git -C "$LOCAL_DIR" fetch "$remote" --quiet || die "fetch failed"
  if git -C "$LOCAL_DIR" merge --ff-only "$remote/$branch" >/dev/null 2>&1; then
    echo "✓ $branch up to date with $remote"
  else
    echo "⚠ $branch could not fast-forward from $remote/$branch — reconcile by hand"
  fi
}

local_status() {
  if [ ! -d "$LOCAL_DIR" ]; then echo "no user layer (./tsc-dev local init)"; return 0; fi
  echo "• branch   $(git -C "$LOCAL_DIR" rev-parse --abbrev-ref HEAD)  ($(git -C "$LOCAL_DIR" rev-parse --short HEAD))"
  echo "• pushes to $(local_push_remote 2>/dev/null || echo '(nowhere — ./tsc-dev local remote <git-url>)')"
  echo "• config   $([ -f "$LOCAL_CONFIG" ] && echo workspace.local.json || echo '(none)')"
  if [ -f "$LOCAL_LOCK" ]; then
    echo "• lock     workspace.lock.json ($(json_count "$LOCAL_LOCK" repos) repos)"
  else
    echo "• lock     (none — ./tsc-dev freeze)"
  fi
  local dirty; dirty="$(git -C "$LOCAL_DIR" status --porcelain)"
  if [ -n "$dirty" ]; then echo "• unsaved:"; printf '%s\n' "$dirty" | sed 's/^/    /'; else echo "• clean (saved)"; fi
}

cmd_local() {
  local sub="${1:-status}"; shift || true
  case "$sub" in
    init)   local_init "$@" ;;
    save)   local_save "$@" ;;
    sync)   local_sync "$@" ;;
    remote) local_remote "$@" ;;
    status) local_status ;;
    *) die "usage: local <init|save|sync|status|remote>" ;;
  esac
}

cmd_config() {
  if [ $# -gt 0 ]; then ws "w[args[0]]" "$1"; echo; return 0; fi
  node "$ROOT/bin/workspace-config.mjs" --explain "$ROOT"
}

cmd_freeze() {
  local out="$LOCAL_LOCK"
  [ "${1:-}" = "-o" ] && { out="${2:?-o needs a path}"; shift 2; }
  [ "$out" = "$LOCAL_LOCK" ] && require_local_layer
  node "$ROOT/bin/env-lock.mjs" capture "$ROOT" > "$out"
  echo "✓ froze $(json_count "$out" repos) repos into ${out#$ROOT/}"
  echo "    ./tsc-dev local save -m 'snapshot'   # version it on your fork"
}

# A peer's workspace fork, registered as a remote so their user branch (and the
# lock on it) can be read without touching your own checkout.
peer_remote() { echo "env-$1"; }

peer_ref() {
  local owner="$1" remote; remote="$(peer_remote "$owner")"
  if git -C "$ROOT" show-ref --verify --quiet "refs/remotes/$remote/user/$owner"; then
    echo "$remote/user/$owner"; return 0
  fi
  git -C "$ROOT" for-each-ref --format='%(refname:short)' "refs/remotes/$remote/user/*" 2>/dev/null | head -1
}

env_add() {
  local owner="${1:?usage: env add <owner> [git-url]}" url="${2:-}"
  if [ -z "$url" ]; then
    # Same repo name as ours, under their account. Derive it from origin rather
    # than from the local directory name, which is whatever each developer
    # happened to call their checkout.
    local name
    name="$(basename -s .git "$(git -C "$ROOT" remote get-url origin 2>/dev/null || basename "$ROOT")")"
    url="https://github.com/$owner/$name.git"
  fi
  local remote; remote="$(peer_remote "$owner")"
  if git -C "$ROOT" remote | grep -qx "$remote"; then
    git -C "$ROOT" remote set-url "$remote" "$url"
  else
    git -C "$ROOT" remote add "$remote" "$url"
  fi
  git -C "$ROOT" fetch "$remote" --quiet || die "could not fetch $url"
  local ref; ref="$(peer_ref "$owner")"
  [ -n "$ref" ] || die "$owner publishes no user/* branch on $url"
  echo "✓ $owner -> $url  (branch $ref)"
}

# Read a file out of a peer's branch without checking anything out.
peer_file() {
  local owner="$1" file="$2" ref; ref="$(peer_ref "$owner")"
  [ -n "$ref" ] || die "unknown peer '$owner' — run: ./tsc-dev env add $owner [git-url]"
  git -C "$ROOT" show "$ref:$file" 2>/dev/null
}

env_list() {
  local r owner
  for r in $(git -C "$ROOT" remote | grep '^env-' || true); do
    owner="${r#env-}"
    printf '• %-16s %-52s %s\n' "$owner" "$(git -C "$ROOT" remote get-url "$r")" "$(peer_ref "$owner")"
  done
}

env_show() {
  local owner="${1:?usage: env show <owner>}"
  peer_file "$owner" "workspace.lock.json" | node "$ROOT/bin/env-lock.mjs" summarize -
}

env_diff() {
  local owner="${1:?usage: env diff <owner>}" tmp rc=0
  tmp="$(mktemp "${TMPDIR:-/tmp}/tsc-dev-lock.XXXXXX")"
  peer_file "$owner" "workspace.lock.json" > "$tmp" || die "no lock on $owner's branch"
  echo "▶ this checkout vs $owner's lock"
  node "$ROOT/bin/env-lock.mjs" diff "$ROOT" "$tmp" || rc=$?
  rm -f "$tmp"
  return $rc
}

# Reproduce a peer's environment. --here mutates this workspace (skipping any
# repo with uncommitted work); --into <dir> builds a fresh workspace instead,
# which is the only way to get an exact copy without disturbing your own.
env_adopt() {
  local owner="" into="" here=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --into) into="${2:?--into needs a directory}"; shift 2 ;;
      --here) here=1; shift ;;
      -*) die "unknown flag '$1'" ;;
      *) owner="$1"; shift ;;
    esac
  done
  [ -n "$owner" ] || die "usage: env adopt <owner> [--here | --into <dir>]"
  [ "$here" = 1 ] || [ -n "$into" ] \
    || die "say where: --here (mutate this workspace) or --into <dir> (fresh copy)"

  local tmp; tmp="$(mktemp "${TMPDIR:-/tmp}/tsc-dev-lock.XXXXXX")"
  peer_file "$owner" "workspace.lock.json" > "$tmp" || die "no lock on $owner's branch"

  local target="$ROOT"
  if [ -n "$into" ]; then
    [ -e "$into" ] && die "$into already exists"
    echo "▶ cloning the workspace tooling into $into"
    git clone --quiet "$ROOT" "$into"
    target="$(cd "$into" && pwd)"
  fi

  local processed=0
  local name branch sha remote url clone_url is_local dir
  while IFS=$'\t' read -r name branch sha remote url clone_url is_local; do
    [ -n "$name" ] || continue
    processed=$((processed + 1))
    dir="$target/$name"
    if [ "$is_local" = "1" ]; then
      echo "  ⚠ $name: local-only in the lock (no remote) — cannot be reproduced"
      continue
    fi
    if [ ! -d "$dir/.git" ]; then
      # Clone from the URL the lock recorded, not an assumed org path: some
      # repos here live only as a personal fork, or under another owner.
      echo "▶ cloning $name"
      git clone --quiet "${clone_url:-$ORG/$name}" "$dir" || { echo "  ✗ clone failed ($clone_url)"; continue; }
    elif [ -n "$(git -C "$dir" status --porcelain)" ]; then
      echo "  ⚠ $name has uncommitted changes — leaving it alone"
      continue
    fi
    # A patch-set branch usually lives on the peer's fork, so add that remote
    # verbatim; without it we would silently reproduce upstream instead.
    if [ "$remote" != "origin" ] && [ -n "$url" ]; then
      git -C "$dir" remote | grep -qx "$owner" || git -C "$dir" remote add "$owner" "$url"
      git -C "$dir" fetch "$owner" --quiet || echo "  ⚠ fetch $owner failed for $name"
    else
      git -C "$dir" fetch origin --quiet || true
    fi
    if git -C "$dir" cat-file -e "${sha}^{commit}" 2>/dev/null; then
      git -C "$dir" checkout --quiet --detach "$sha" && echo "  ✓ $name @ ${sha:0:8} ($branch)"
    else
      echo "  ✗ $name: commit ${sha:0:8} not found on any remote (unpushed work?)"
    fi
  done < <(node -e 'const fs=require("fs");const l=JSON.parse(fs.readFileSync(process.argv[1],"utf8"));for(const [n,r] of Object.entries(l.repos||{}))console.log([n,r.branch,r.sha,r.remote,r.remoteUrl,r.cloneUrl||"",r.local?1:0].join("\t"))' "$tmp")

  [ "$processed" -gt 0 ] || { rm -f "$tmp"; die "$owner's lock lists no repos (is workspace.lock.json valid?)"; }

  if peer_file "$owner" "workspace.local.json" > "$target/.workspace.local.from-$owner.json" 2>/dev/null; then
    echo "  ↳ their config layer saved as .workspace.local.from-$owner.json"
  else
    rm -f "$target/.workspace.local.from-$owner.json"
  fi
  rm -f "$tmp"
  echo "✓ adopted $owner's environment in $target"
  echo "    cd $target && ./tsc-dev install && ./tsc-dev env diff $owner"
}

cmd_gen_map() {
  local mode="write"
  [ "${1:-}" = "--check" ] && mode="check"
  node "$ROOT/bin/gen-map.mjs" "$mode" "$ROOT"
}

# The workspace's own tests. Always give bun an explicit path: the workspace
# root has ~60 cloned repos under it, and a bare `bun test` would walk into all
# of them.
cmd_test() {
  command -v bun >/dev/null 2>&1 || die "bun is not installed"
  if [ $# -gt 0 ]; then (cd "$ROOT" && bun test "$@"); else (cd "$ROOT" && bun test ./test/); fi
}

cmd_env() {
  local sub="${1:-list}"; shift || true
  case "$sub" in
    add)   env_add "$@" ;;
    list)  env_list ;;
    show)  env_show "$@" ;;
    diff)  env_diff "$@" ;;
    adopt) env_adopt "$@" ;;
    *) die "usage: env <add|list|show|diff|adopt>" ;;
  esac
}

# The repos carrying the active patch-set effort, and each one's branch — both
# from workspace.json, so a second effort is a config change, not a code change.
# Pick a different effort with SYNC_FORK_EFFORT.
sync_fork_repos() {
  ws "w.forkEfforts[process.env.SYNC_FORK_EFFORT||w.defaultForkEffort].repos"
}

sync_fork_branch_for() {
  ws "(e=>e.branchOverrides?.[args[0]]||e.defaultBranch)(w.forkEfforts[process.env.SYNC_FORK_EFFORT||w.defaultForkEffort])" "$1"
}

# After a successful fork rebase+push, move the local branch onto the rewritten
# commits. Safe by construction: the rebase source is always a superset of the
# local branch, so no local commit can be dropped. Uncommitted edits are
# stashed and reapplied.
sync_local_branch() {
  local dir="$1" branch="$2" new_head="$3" cur
  git -C "$dir" show-ref --verify --quiet "refs/heads/$branch" || return 0
  if [ "$(git -C "$dir" rev-parse "$branch")" = "$new_head" ]; then return 0; fi
  cur="$(git -C "$dir" symbolic-ref --quiet --short HEAD 2>/dev/null || true)"
  if [ "$cur" != "$branch" ]; then
    git -C "$dir" branch -f "$branch" "$new_head"
    echo "  ↳ local $branch moved to rebased head (not checked out)"
  elif git -C "$dir" diff --quiet && git -C "$dir" diff --cached --quiet; then
    git -C "$dir" reset --hard "$new_head" -q
    echo "  ↳ local $branch reset to rebased head"
  else
    # Dirty trees are the norm here (yalc rewrites package.json), so stash
    # rather than refuse — otherwise the local branch could never converge.
    # Untracked files survive reset --hard, so only tracked changes are stashed.
    if git -C "$dir" stash push -q -m "tsc-dev sync-forks autostash"; then
      git -C "$dir" reset --hard "$new_head" -q
      if git -C "$dir" stash pop -q 2>/dev/null; then
        echo "  ↳ local $branch reset to rebased head (local edits reapplied)"
      else
        echo "  ⚠ local $branch reset, but reapplying edits conflicted —"
        echo "      resolve then drop:  git -C $dir status && git -C $dir stash drop"
      fi
    else
      echo "  ⚠ local $branch left at $(git -C "$dir" rev-parse --short "$branch") (couldn't stash) — run:"
      echo "      git -C $dir reset --hard $(git -C "$dir" rev-parse --short "$new_head")"
    fi
  fi
}

# Keep local main usable as a branching point. Fast-forward only: a local main
# that is ahead of or diverged from upstream is reported, never rewritten.
fast_forward_local_main() {
  local dir="$1" cur
  git -C "$dir" show-ref --verify --quiet refs/heads/main || return 0
  git -C "$dir" show-ref --verify --quiet refs/remotes/origin/main || return 0
  if [ "$(git -C "$dir" rev-parse main)" = "$(git -C "$dir" rev-parse origin/main)" ]; then return 0; fi
  if ! git -C "$dir" merge-base --is-ancestor main origin/main; then
    echo "  ⚠ local main has commits not on origin/main — left alone"
    return 0
  fi
  cur="$(git -C "$dir" symbolic-ref --quiet --short HEAD 2>/dev/null || true)"
  if [ "$cur" != "main" ]; then
    git -C "$dir" branch -f main origin/main
    echo "  ↳ local main fast-forwarded to $(git -C "$dir" rev-parse --short origin/main)"
  elif git -C "$dir" merge --ff-only origin/main --quiet 2>/dev/null; then
    echo "  ↳ local main fast-forwarded to $(git -C "$dir" rev-parse --short origin/main)"
  else
    echo "  ⚠ local main checked out with local changes — run: git -C $dir merge --ff-only origin/main"
  fi
}

# Keep each fork updated to head of upstream main with our patch branch on top.
# Rebase in a temporary worktree so dirty checkouts and active yalc links remain
# untouched. Sync the fork's default branch even when no patch branch exists.
# Set SYNC_FORK_BRANCH to force one branch name for every repo.
cmd_sync_forks() {
  command -v gh >/dev/null 2>&1 || die "sync-forks needs the GitHub CLI (gh)"
  local repos=("$@"); [ ${#repos[@]} -eq 0 ] && { repos=(); while IFS= read -r t; do [ -n "$t" ] && repos+=("$t"); done < <(sync_fork_repos); }
  local repo dir fork_url fork_slug out branch branch_ref sync_root sync_dir conflict_files
  local local_ref fork_ref branch_src diverged new_head fork_fetch_ok
  for repo in "${repos[@]}"; do
    have "$repo" || { echo "⚠ $repo: not cloned — skipping"; continue; }
    branch="${SYNC_FORK_BRANCH:-$(sync_fork_branch_for "$repo")}"
    dir="$ROOT/$repo"
    echo "=== $repo ($branch) ==="
    git -C "$dir" remote | grep -qx fork \
      || { echo "  ⚠ no 'fork' remote — run: ./tsc-dev fork $repo"; continue; }
    git -C "$dir" fetch origin --quiet || { echo "  ✗ fetch failed — skipping"; continue; }
    fork_fetch_ok=1
    if ! git -C "$dir" fetch fork --prune --quiet; then
      echo "  ✗ fork fetch failed — skipping patch rebase"
      fork_fetch_ok=0
    fi

    local_ref=""; fork_ref=""; branch_ref=""; branch_src=""; diverged=0
    if [ "$fork_fetch_ok" -eq 1 ]; then
      if git -C "$dir" show-ref --verify --quiet "refs/heads/$branch"; then
        local_ref="refs/heads/$branch"
      fi
      if git -C "$dir" show-ref --verify --quiet "refs/remotes/fork/$branch"; then
        fork_ref="refs/remotes/fork/$branch"
      fi

      # Rebase whichever ref is a strict superset, so local-only commits are
      # never silently dropped (and fork-only commits are never force-pushed
      # away). Refuse to guess when the two have genuinely diverged.
      if [ -n "$local_ref" ] && [ -n "$fork_ref" ]; then
        if git -C "$dir" merge-base --is-ancestor "$fork_ref" "$local_ref"; then
          branch_ref="$local_ref"; branch_src="local"
        elif git -C "$dir" merge-base --is-ancestor "$local_ref" "$fork_ref"; then
          branch_ref="$fork_ref"; branch_src="fork"
        else
          diverged=1
        fi
      elif [ -n "$local_ref" ]; then
        branch_ref="$local_ref"; branch_src="local"
      elif [ -n "$fork_ref" ]; then
        branch_ref="$fork_ref"; branch_src="fork"
      fi
    fi

    if [ "$diverged" -eq 1 ]; then
      echo "  ✗ local $branch and fork/$branch have diverged — refusing to guess."
      echo "      reconcile, then re-run:  git -C $dir rebase fork/$branch"
    elif [ -n "$branch_ref" ]; then
      echo "  ↳ rebasing from $branch_src ($(git -C "$dir" rev-parse --short "$branch_ref"))"
      sync_root="$(mktemp -d "${TMPDIR:-/tmp}/tsc-dev-sync-${repo}.XXXXXX")"
      sync_dir="$sync_root/worktree"
      if git -C "$dir" worktree add --detach "$sync_dir" "$branch_ref" --quiet; then
        if out="$(git -C "$sync_dir" rebase origin/main 2>&1)"; then
          echo "  ↳ rebased onto origin/main ($(git -C "$dir" rev-parse --short origin/main))"
          if out="$(git -C "$sync_dir" push --force-with-lease fork "HEAD:refs/heads/$branch" 2>&1)"; then
            echo "  ↳ push fork: $(printf '%s' "$out" | tail -1 | sed 's/^[[:space:]]*//')"
            new_head="$(git -C "$sync_dir" rev-parse HEAD)"
            sync_local_branch "$dir" "$branch" "$new_head"
          else
            echo "  ✗ push fork: $(printf '%s' "$out" | tail -1 | sed 's/^[[:space:]]*//')"
          fi
        else
          conflict_files="$(git -C "$sync_dir" diff --name-only --diff-filter=U | paste -sd, -)"
          git -C "$sync_dir" rebase --abort 2>/dev/null || true
          echo "  ✗ rebase conflict${conflict_files:+ in $conflict_files} — patch branch unchanged"
        fi
        git -C "$dir" worktree remove --force "$sync_dir" >/dev/null 2>&1 || true
      else
        echo "  ✗ couldn't create isolated worktree — skipping patch rebase"
      fi
      rmdir "$sync_root" 2>/dev/null || true
    else
      if [ "$fork_fetch_ok" -eq 1 ]; then
        echo "  ⚠ no '$branch' branch on fork or locally — skipping patch rebase"
      fi
    fi

    fork_url="$(git -C "$dir" remote get-url fork)"
    fork_slug="$(printf '%s' "$fork_url" | sed -E 's#.*github\.com[:/]([^/]+/[^/.]+)(\.git)?/?$#\1#')"
    if out="$(gh repo sync "$fork_slug" 2>&1)"; then
      out="$(printf '%s' "$out" | tail -1 | sed 's/^[[:space:]]*//')"
      echo "  ↳ sync $fork_slug main: ${out:-✓ up to date with upstream}"
    else
      echo "  ↳ sync $fork_slug main: ✗ $(printf '%s' "$out" | tail -1 | sed 's/^[[:space:]]*//')"
    fi
    fast_forward_local_main "$dir"
  done
}

main() {
  local cmd="${1:-}"; shift || true
  case "$cmd" in
    clone)   cmd_clone "$@" ;;
    clone-group) cmd_clone_group "$@" ;;
    clone-deps)  cmd_clone_deps "$@" ;;
    search)  cmd_search "$@" ;;
    install) cmd_install "$@" ;;
    publish) cmd_publish "$@" ;;
    watch)   cmd_watch "$@" ;;
    link)    cmd_link "$@" ;;
    push)    cmd_push "$@" ;;
    unlink)  cmd_unlink "$@" ;;
    doctor)  cmd_doctor "$@" ;;
    prune-store) cmd_prune_store "$@" ;;
    pr)       cmd_pr "$@" ;;
    pr-check) cmd_pr_check "$@" ;;
    pr-push)  cmd_pr_push "$@" ;;
    pr-link)  cmd_pr_link "$@" ;;
    fork)     cmd_fork "$@" ;;
    local)    cmd_local "$@" ;;
    config)   cmd_config "$@" ;;
    freeze)   cmd_freeze "$@" ;;
    env)      cmd_env "$@" ;;
    gen-map)  cmd_gen_map "$@" ;;
    test)     cmd_test "$@" ;;
    pr-list)  cmd_pr_list "$@" ;;
    pr-rm)    cmd_pr_rm "$@" ;;
    rebuild) cmd_rebuild "$@" ;;
    dev)     cmd_dev "$@" ;;
    pkgname) pkgname "${1:?usage: pkgname <repo>}" ;;
    status)  cmd_status ;;
    sync-forks) cmd_sync_forks "$@" ;;
    ""|-h|--help|help) sed -n '2,/^# Examples:/p' "${BASH_SOURCE[0]}" | sed '$d;s/^# \{0,1\}//' ;;
    *) die "unknown command '$cmd' (try: ./tsc-dev help)" ;;
  esac
}
main "$@"
